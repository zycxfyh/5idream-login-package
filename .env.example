# 5idream FastAPI 服务配置样例。复制为 .env 后按需修改。
# 也可直接使用环境变量，前缀 DREAM_，例如 DREAM_MAX_ROWS=200

# 5idream 站点
# BASE_URL=https://www.5idream.net

# 每次请求前的随机等待秒数（频率控制，避免风控）
# REQUEST_DELAY_RANGE=0.5,1.5

# 等待扫码确认的最大秒数
# LOGIN_TIMEOUT_SECONDS=90

# 每类数据请求的最大条数
# MAX_ROWS=100

# token 个人缓存空闲过期秒数（0=不过期，重启进程清空）
# TOKEN_IDLE_TTL=3600

# 采集数据缓存秒数（0=不缓存）
# DATA_CACHE_TTL=60

# 登录会话保留秒数
# SESSION_TTL=1800

# 允许跨域来源（逗号分隔；* 表示全部）
# CORS_ORIGINS=*
